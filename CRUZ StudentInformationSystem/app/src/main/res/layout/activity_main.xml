<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <!-- ================================= -->
        <!-- APPLICATION HEADER -->
        <!-- ================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="22dp">
            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#173B70"
                android:gravity="center"
                android:text="NU"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="19sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NATIONAL UNIVERSITY"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student Information System"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================================= -->
        <!-- LOGIN SCREEN -->
        <!-- ================================= -->
        <LinearLayout
            android:id="@+id/loginLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:elevation="4dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome Back!"
                android:textColor="#173B70"
                android:textStyle="bold"
                android:textSize="25sp"
                android:gravity="center"
                android:paddingBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Login to manage student records."
                android:textColor="#777777"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingBottom="28dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="#173B70"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter username"
                android:inputType="text"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#173B70"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_marginBottom="25dp" />
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOGIN"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#173B70"
                android:padding="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NU Student Information System"
                android:textColor="#999999"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingTop="20dp" />
        </LinearLayout>

        <!-- ================================= -->
        <!-- MAIN DASHBOARD -->
        <!-- ================================= -->
        <LinearLayout
            android:id="@+id/dashboardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <!-- Dashboard title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#173B70"
                android:textStyle="bold"
                android:textSize="25sp"
                android:paddingBottom="5dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage and organize student information."
                android:textColor="#777777"
                android:textSize="13sp"
                android:paddingBottom="18dp" />

            <!-- Total student count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#173B70"
                android:padding="20dp"
                android:layout_marginBottom="22dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TOTAL REGISTERED STUDENTS"
                    android:textColor="#D8E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvTotalStudents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Registered Students: 0"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <!-- ================================= -->
            <!-- STUDENT REGISTRATION FORM -->
            <!-- ================================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="18dp"
                android:elevation="3dp">
                <TextView
                    android:id="@+id/tvFormTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Register New Student"
                    android:textColor="#173B70"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:paddingBottom="5dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter the student's personal and academic information."
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:paddingBottom="20dp" />

                <!-- Student Number -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student Number *"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etStudentNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter student number"
                    android:inputType="text"
                    android:padding="11dp"
                    android:layout_marginBottom="15dp" />

                <!-- Student Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student Name"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:paddingBottom="8dp" />
                <EditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Last Name *"
                    android:inputType="textCapWords"
                    android:padding="11dp"
                    android:layout_marginBottom="9dp" />
                <EditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="First Name *"
                    android:inputType="textCapWords"
                    android:padding="11dp"
                    android:layout_marginBottom="9dp" />
                <EditText
                    android:id="@+id/etMiddleName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Middle Name (Optional)"
                    android:inputType="textCapWords"
                    android:padding="11dp"
                    android:layout_marginBottom="22dp" />

                <!-- Academic Information -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Academic Information"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:paddingBottom="12dp" />

                <!-- Program -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Program"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <Spinner
                    android:id="@+id/spProgram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:layout_marginBottom="15dp" />

                <!-- College (Automatic) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="College (Automatically Assigned)"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvCollege"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select a program first"
                    android:textColor="#285DAA"
                    android:textSize="13sp"
                    android:background="#EDF3FF"
                    android:padding="13dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="17dp" />

                <!-- Year Level -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Year Level"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <Spinner
                    android:id="@+id/spYearLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:layout_marginBottom="22dp" />

                <!-- Form buttons -->
                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ADD STUDENT"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:backgroundTint="#F5C542"
                    android:padding="11dp" />
                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CLEAR FORM"
                    android:textColor="#173B70"
                    android:backgroundTint="#E8EEF7"
                    android:layout_marginTop="7dp" />
            </LinearLayout>

            <!-- ================================= -->
            <!-- STUDENT DIRECTORY -->
            <!-- ================================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student Directory"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:textSize="21sp"
                    android:paddingBottom="5dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View, search, edit, and delete student records."
                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:paddingBottom="13dp" />
                <!-- Search -->
                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search by name, student number, or program"
                    android:drawablePadding="8dp"
                    android:inputType="text"
                    android:padding="13dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="15dp" />
                <!-- Student cards appear here -->
                <LinearLayout
                    android:id="@+id/studentListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOGOUT"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#173B70"
                android:layout_marginTop="20dp"
                android:padding="12dp" />
        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NATIONAL UNIVERSITY • STUDENT INFORMATION SYSTEM"
            android:textColor="#999999"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingTop="25dp"
            android:paddingBottom="15dp" />
    </LinearLayout>
</ScrollView>